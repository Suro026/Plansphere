{
  "name": "plansphere",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "backup:firestore": "node --env-file=.env.local scripts/backup-firestore.mjs",
    "backup:auth": "node --env-file=.env.local scripts/backup-auth.mjs",
    "check:credential": "node --env-file=.env.local scripts/check-credential.mjs",
    "verify:admin": "node --env-file=.env.local scripts/verify-admin.mjs",
    "grant-super-admin": "node --env-file=.env.local scripts/grant-super-admin.mjs",
    "platform-staff": "node --env-file=.env.local scripts/platform-staff.mjs",
    "firebase:deploy": "node --env-file=.env.local scripts/deploy-firebase.mjs",
    "migrate:accounts": "node --env-file=.env.local scripts/migrate-accounts.mjs",
    "inspect:accounts": "node --env-file=.env.local scripts/inspect-accounts.mjs",
    "verify:infra": "node --env-file=.env.local scripts/verify-infra.mjs",
    "test": "vitest run --project unit --file-parallelism",
    "test:watch": "vitest --project unit --file-parallelism",
    "test:emulator": "npx firebase-tools@15 emulators:exec --only firestore,auth --project plansphere-test \"vitest run --project emulator\"",
    "test:all": "npm test && npm run test:emulator",
    "demo:emulators": "node scripts/demo/emulators.mjs",
    "demo:seed": "node scripts/demo/run.mjs seed",
    "demo:clean": "node scripts/demo/run.mjs clean",
    "demo:app": "node scripts/demo/app.mjs",
    "demo:cards": "node scripts/demo/video/serve.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:secrets:history": "node scripts/scan-secrets.mjs --history",
    "migrate:rbac": "node --env-file=.env.local scripts/migrate-rbac.mjs",
    "migrate:fests": "node --env-file=.env.local scripts/migrate-fest-containers.mjs",
    "migrate:event-head": "node --env-file=.env.local scripts/migrate-event-head.mjs",
    "migrate:memberships": "node --env-file=.env.local scripts/migrate-memberships.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/nextjs": "^10.75.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.83.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.453.0",
    "next": "15.5.28",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.61.1",
    "react-qr-code": "^2.0.18",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "15.5.28",
    "fake-indexeddb": "^6.2.5",
    "google-auth-library": "^10.9.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "not dead"
  ],
  "overrides": {
    "uuid": "^11.1.1",
    "postcss": "^8.5.28",
    "@grpc/grpc-js": "1.14.5"
  }
}

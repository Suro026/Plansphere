# ---------------------------------------------------------------------------
# Firebase Web SDK (client)
#
# These are public identifiers. They ship inside the JavaScript bundle by
# design and are not secrets — access is controlled by Firebase Auth and the
# Firestore security rules in firestore.rules, never by hiding these values.
# They live in env vars so that staging and production can point at different
# Firebase projects, not for secrecy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Public base URL of the deployment, used to build links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server only)
#
# THIS ONE IS A REAL SECRET. It bypasses every Firestore security rule.
# Never prefix it with NEXT_PUBLIC_, never commit it, and rotate it in the
# Firebase console if it is ever exposed.
#
# Paste the full service account JSON on a single line, or base64-encode it.
# Firebase console -> Project settings -> Service accounts -> Generate new key
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Supabase Storage (server only) — file uploads only. Auth and the database
# are still Firebase; nothing Supabase-related is used for either.
#
# SUPABASE_SERVICE_ROLE_KEY IS A REAL SECRET. It bypasses every storage
# policy. Never prefix it with NEXT_PUBLIC_ and never commit it. Uploads
# degrade gracefully (paste a URL instead) when these are unset.
#
# Supabase dashboard -> Project settings -> API. Create four buckets with
# these exact names: event-assets (public), avatars (public),
# certificates (private), uploads (private).
#
# The names matter. The Supabase quick-start's NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are NOT read by this app (it does no
# storage from the browser); with only those set, uploads are silently off.
# /api/health and `npm run verify:infra` say so. See docs/STORAGE-SETUP.md.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Not currently used server-side (no Supabase Auth/RLS-backed client calls),
# kept for parity with the Supabase dashboard's "anon" key if a future
# client-side read ever needs it.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Bootstrap super admin
#
# The one account allowed to grant roles before any super admin exists. Set it
# to an address you control, sign up with it, then run `npm run grant-super-admin`.
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Email delivery
#
# EMAIL_PROVIDER selects the EmailService implementation:
#   console  - logs the message instead of sending it (default in development)
#   resend   - production; requires RESEND_API_KEY. EMAIL_FROM defaults to
#              "Plansphere <noreply@plansphere.in>" (the domain must be verified
#              in Resend: add its DKIM/SPF/DMARC records to plansphere.in DNS).
# Every send is written to the `emailLog` collection either way.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Plansphere <noreply@plansphere.in>

# Shared secret Vercel Cron sends as `Authorization: Bearer …` to
# /api/cron/event-reminders (day-before reminders). Any long random string;
# Vercel injects it automatically once set in the project's env.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Online payment for paid events (optional; ALL OFF by default)
# ---------------------------------------------------------------------------
# Free events never need any of this. Read docs/payments-implementation.md
# ("Before activation") before setting anything here. Values are never
# committed; the encryption key and any merchant credentials live only in the
# deployment's environment / the app's encrypted store.
#
# 1 lets fests with an approved payment account create orders at all.
PAYMENTS_ENABLED=
# 1 additionally allows accounts in `live` mode (real money). Leave unset until
# the provider's account model, KYC, fees and settlement are verified.
PAYMENTS_LIVE_ENABLED=
# Development / CI only: registers the fake in-repo provider. Ignored (and
# warned about) when NODE_ENV is production.
PAYMENTS_ALLOW_TEST_PROVIDER=
# How long an unpaid seat is held, in minutes (5-60, default 15).
PAYMENT_HOLD_MINUTES=
# base64 of 32 random bytes; encrypts merchant credentials at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes saved credentials unreadable; rotating it needs them re-entered.
PAYMENT_SECRET_KEY=
# Rotation: move the old key here (comma-separated, decrypt-only), put the new one
# in PAYMENT_SECRET_KEY, deploy, then POST /api/admin/payments/keys {"dryRun":false}
# as a platform administrator. Drop the old key only when it reports nothing left.
PAYMENT_SECRET_KEYS_PREVIOUS=

# ---------------------------------------------------------------------------
# Monitoring & protection (all optional; features switch on when set)
# ---------------------------------------------------------------------------
# Sentry: errors from browser, server and edge. Source maps upload only when
# SENTRY_AUTH_TOKEN (+ SENTRY_ORG/SENTRY_PROJECT) are set on the build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Firebase App Check with reCAPTCHA v3. Site key from the Firebase console
# (App Check → Apps → Web). APP_CHECK_ENFORCE=true refuses API calls without
# a valid token; leave unset to monitor first.
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=
APP_CHECK_ENFORCE=false

# Rate limiting (see src/server/rate-limit.ts for the policy table).
# Shared store across serverless instances (Upstash Redis REST); without it
# limits are per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Per-bucket overrides, JSON keyed by bucket name, applied without a code change:
#   {"auth.login":{"limit":10,"windowSeconds":900},"public.verify":{"limit":120}}
RATE_LIMIT_OVERRIDES=
# Emergency off switch (1 = no limits). Leave unset.
RATE_LIMIT_DISABLED=

# ENV_STRICT=1 makes a production deploy fail to start when a required
# variable is missing (instead of running degraded). Recommended once live.
ENV_STRICT=
